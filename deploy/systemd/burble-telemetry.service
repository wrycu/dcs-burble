# Burble usage report receiver (hubs' daily anonymous counts) as a systemd *user* service. Runs without a hub.
# Listens on 127.0.0.1:8100 by default; publish it through a reverse proxy (e.g. Caddy: `telemetry.example.com {
# reverse_proxy 127.0.0.1:8100 }`).
# Install: cp deploy/systemd/*.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#          systemctl --user enable --now burble-telemetry
# Settings: [telemetry] in ~/.burble/config.toml (its data in ~/.burble/telemetry by default).
# Then: `uv run burble telemetry set-password` (the Usage page at /), and `uv run burble telemetry new-key NAME` for a
# hub's admins to show its stats on their Usage page.
[Unit]
Description=Burble usage report receiver

[Install]
WantedBy=default.target

[Service]
WorkingDirectory=%h/dcs-burble
ExecStart=%h/.local/bin/uv run --frozen burble telemetry
Restart=always
RestartSec=5
