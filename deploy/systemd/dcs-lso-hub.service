# dcs-lso hub (website, greenie board, grading, slice archive) as a systemd *user* service.
# Listens on 127.0.0.1:8000 only; publish it through a reverse proxy (e.g. Caddy).
# Install: cp deploy/systemd/*.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#          systemctl --user enable --now dcs-lso-hub
# A new hub: create its data folder first, e.g. `uv run dcs-lso hub --data-dir ~/dcs-lso-data/central --create add-agent server1`
# (the hub refuses a data folder without lso.db otherwise, so a mistyped path never starts an empty hub).
# Replaces dcs-lso-central.service (same data directory): systemctl --user disable --now dcs-lso-central
[Unit]
Description=dcs-lso hub (greenie board, grading, ACMI archive)

[Install]
WantedBy=default.target

[Service]
WorkingDirectory=%h/dcs-lso
# Optional settings, e.g. Discord (see `dcs-lso hub serve --help`):
#   DCS_LSO_PUBLIC_URL=https://lso.example.com
#   DCS_LSO_DISCORD_BOARD_WEBHOOK=https://discord.com/api/webhooks/...
#   DCS_LSO_DISCORD_TRAPS_WEBHOOK=https://discord.com/api/webhooks/...
EnvironmentFile=-%h/.config/dcs-lso/hub.env
ExecStart=%h/.local/bin/uv run --frozen dcs-lso hub --data-dir %h/dcs-lso-data/central serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
