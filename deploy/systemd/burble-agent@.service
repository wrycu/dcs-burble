# Burble server agent for one DCS server instance (instance name = dcs-server-wine's, e.g. "server1"),
# as a systemd *user* service next to dcs-server@.service.
# Settings: [agent] in ~/.burble/config.toml for every instance, and [agent.<instance>] for this one's own, e.g.
#   [agent.server1]
#   token = "<server agent token from `burble hub add-agent <name>`>"
#   tacview_password = "<tacviewRealTimeTelemetryPassword>"
#   dcs_log = "~/.wine/drive_c/DCS_configs/DCS.server1/Logs/dcs.log"
# Voice clips: `burble voice build` (into ~/.burble/voice). Listening to pilots' calls (answering "Roger ball"): turn it
#   on in the hub's config for this server ("listen": true under "callouts"); the agent downloads its Vosk model.
# Enable: systemctl --user enable --now burble-agent@server1
[Unit]
Description=Burble server agent for DCS.%i
After=dcs-server@%i.service

[Install]
WantedBy=default.target

[Service]
WorkingDirectory=%h/dcs-burble
ExecStart=%h/.local/bin/uv run --frozen burble agent %i
Restart=always
RestartSec=5
